<% let form = FormValues(values, errors: errors) %>
<.form action={action} method={method} class="editor-form" attributes={["novalidate": ""]}>
    <.input field={form["title"]} label="Title" placeholder="Something worth reading" required={true} maxLength={160} />
    <.input field={form["url"]} label="Link" type="url" placeholder="https://" required={true} />
    <.textarea field={form["note"]} label="A note for later (optional)" placeholder="Why did this catch your eye?" maxLength={2000} />
    <.input field={form["read"]} label="I've already read this" type="checkbox" labelClass="checkbox-label" />
    <div class="form-actions"><button type="submit"><%= button %></button><a href="/bookmarks">Cancel</a></div>
</.form>
